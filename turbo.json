{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "codegen": { "outputs": ["generated/**"] },
    "build": { "dependsOn": ["^build", "codegen", "^codegen"], "outputs": ["dist/**", "build/**"] },
    "typecheck": { "dependsOn": ["codegen", "^codegen", "^build"] },
    "lint": { "dependsOn": ["codegen", "^codegen", "^build"] },
    "dev": { "dependsOn": ["codegen", "^codegen", "^build"], "cache": false, "persistent": true },
    "schema": { "dependsOn": ["build"], "cache": false }
  }
}
