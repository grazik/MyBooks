{
  "name": "@mybooks/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "codegen": "graphql-codegen"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@mybooks/config": "workspace:*",
    "@mybooks/graphql": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "catalog:",
    "graphql": "catalog:",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte2tsx": "^0.7.63",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#graphql": "./generated/graphql/index.js"
  }
}
